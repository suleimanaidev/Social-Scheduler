# ---------------------------------------------------------------------------
# Social Scheduler — environment variables (placeholders only, never real secrets)
# Copy this file to `.env.local` and fill in real values.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ------------------------------------------------------------------
# Base URL of this app, used to build OAuth redirect URIs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Token encryption (server only) --------------------------------------
# 32+ random characters. Used to AES-256-GCM encrypt stored OAuth tokens.
ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- Publishing worker (Edge Function) ------------------------------------
# Shared secret used to invoke the `publish` Edge Function from a scheduler.
CRON_SECRET=change-me-to-a-long-random-string

# Comma-separated emails allowed into the admin panel (/admin).
ADMIN_EMAILS=you@example.com

# --- Facebook / Instagram (Meta Graph API) --------------------------------
# Instagram publishing uses a Facebook app (Instagram Basic Display is read-only).
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# --- LinkedIn -------------------------------------------------------------
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# --- TikTok (Content Posting API) -----------------------------------------
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# --- Pinterest ------------------------------------------------------------
PINTEREST_APP_ID=your-pinterest-app-id
PINTEREST_APP_SECRET=your-pinterest-app-secret
